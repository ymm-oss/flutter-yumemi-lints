{
  "dart.sdkPath": ".vscode/mise-tools/dart",
  "mise.configureExtensionsAutomatically": true,
  "mise.configureExtensionsIncludeGlobalTools": false,
  "mise.configureExtensionsUseSymLinks": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-issue-config.json": ".github/ISSUE_TEMPLATE/config.yaml",
  },
  "json.schemas": [
    {
      "fileMatch": [
        ".vscode/*.json"
      ],
      "schema": {
        "allowTrailingCommas": true,
      },
    },
  ],
}
